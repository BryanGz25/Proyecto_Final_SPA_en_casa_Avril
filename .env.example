# Token publico de Mapbox (empieza con "pk."). Lo usa el mapa del carrito con
# el estilo satellite. Si falta, esta vacio o responde 401, la app cae al mapa
# de respaldo con OpenStreetMap.
# OJO: la firma debe terminar en "D4rYFSURw"; transponer esos dos caracteres
# hace que Mapbox responda 401 INVALID_TOKEN.
# Crear tokens en https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Webhooks de producción de n8n Cloud. Para un n8n local usa
# http://localhost:5678/webhook/... (reinicia `npm run dev` tras cambiarlas).
VITE_N8N_WEBHOOK_URL=https://bryanbs25.app.n8n.cloud/webhook/avrill-pedido
VITE_N8N_CHAT_URL=https://bryanbs25.app.n8n.cloud/webhook/avrill-chat
